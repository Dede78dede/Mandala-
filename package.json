{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "NODE_ENV=production vite build",
    "build:analyze": "NODE_ENV=production ANALYZE=true vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "wasm:build": "python3 scripts/build_wasm.py",
    "wasm:check": "node scripts/ci/check-wasm-budget.mjs",
    "manifest:build": "python3 scripts/release_manifest.py",
    "android:sync": "node scripts/sync_android_assets.mjs",
    "release:setup-help": "python3 scripts/setup_android_release.py --check",
    "bench:update": "npx tsx scripts/ci/run-benchmark-gate.ts --update",
    "bench:gate": "npx tsx scripts/ci/run-benchmark-gate.ts",
    "size:check": "npx size-limit",
    "a11y:exemptions": "node scripts/ci/validate-a11y-exemptions.mjs",
    "quality:gate": "node scripts/ci/check-code-quality.mjs",
    "lhci:check": "node scripts/ci/run-lighthouse-gate.mjs",
    "e2e": "npx playwright test",
    "verify:release": "npm run manifest:build && npm run wasm:check && npm test && npm run bench:gate && npm run build:analyze && npm run size:check && npm run a11y:exemptions && npm run e2e && npm run lhci:check"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.14.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lighthouse": "^13.6.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "size-limit": "^14.3.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
